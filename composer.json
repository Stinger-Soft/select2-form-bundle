{
  "name": "stinger-soft/select2-form-bundle",
  "type": "symfony-bundle",
  "description": "Adds common forms with select2 support",
  "autoload": {
    "psr-4": {
      "StingerSoft\\Select2FormBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StingerSoft\\Select2FormBundle\\": "tests/"
    }
  },
  "require": {
    "php": "^8.1",
    "symfony/translation-contracts": "^3.0",
    "symfony/framework-bundle": "^6.4",
    "symfony/form": "^6.4",
    "symfony/intl": "^6.4",
    "oomphinc/composer-installers-extender": "^2.0",
    "doctrine/doctrine-bundle": "^2.0",
    "doctrine/instantiator": "^2.0",
    "doctrine/orm": "^3",
    "doctrine/common": "^3"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.3.1",
    "phpstan/phpstan": "^1.10.28",
    "phpstan/phpstan-doctrine": "^1.3",
    "phpstan/phpstan-symfony": "^1.3",
    "phpspec/prophecy": "v1.19.0",
    "phpspec/prophecy-phpunit": "v2.2.0",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.7",
    "symfony/test-pack": "*"
  },
  "extra": {
    "foxy": true,
    "branch-alias": {
      "dev-master": "1.0.x-dev",
      "dev-develop": "2.0.x-dev"
    }
  },
  "keywords": [
    "Stinger Soft",
    "Select2",
    "Form"
  ],
  "authors": [
    {
      "name": "Florian Meyer",
      "email": "florian.meyer@stinger-soft.net",
      "role": "Developer"
    },
    {
      "name": "Oliver Kotte",
      "email": "oliver.kotte@stinger-soft.net",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "discard-changes": true,
    "allow-plugins": {
      "foxy/foxy": true,
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true,
      "phpstan/extension-installer": true
    }
  }
}
