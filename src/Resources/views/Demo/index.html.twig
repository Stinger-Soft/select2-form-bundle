{% extends '@PecKeenAdminTheme/Templates/base.html.twig' %}
{% trans_default_domain "PecSelect2FormBundle" %}

{% block body %}
<div class="form">
	{% form_theme form with ['PecSelect2FormBundle::form_theme.html.twig', 'PecPlatformBundle:Form:fields.html.twig'] %}
	{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
	{{ form_rest(form) }}
	{{ form_end(form) }}
</div>	
{% endblock body %}